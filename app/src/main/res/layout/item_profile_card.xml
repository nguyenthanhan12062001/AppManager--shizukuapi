<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/Widget.ShizukuManager.GlassCard"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/space_sm"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvProfileName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.ShizukuManager.SectionTitle" />

            <TextView
                android:id="@+id/tvProfileDesc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textAppearance="@style/TextAppearance.ShizukuManager.Body" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/btnProfileRename"
            android:layout_width="@dimen/min_touch_target"
            android:layout_height="@dimen/min_touch_target"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/profile_action_rename"
            android:src="@drawable/ic_edit"
            app:tint="@color/brand_primary" />

        <ImageButton
            android:id="@+id/btnProfileDelete"
            android:layout_width="@dimen/min_touch_target"
            android:layout_height="@dimen/min_touch_target"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/profile_action_delete"
            android:src="@drawable/ic_delete"
            app:tint="@color/btn_uninstall_start" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_xs"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvProfileAppsCount"
            style="@style/Widget.ShizukuManager.StatePill"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/pill_user"
            android:textColor="@color/state_user_fg" />

        <TextView
            android:id="@+id/tvProfileSavedState"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_xs"
            android:layout_weight="1"
            android:textAppearance="@style/TextAppearance.ShizukuManager.Caption" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_sm"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnProfileManageApps"
            style="@style/Widget.ShizukuManager.Button.Secondary"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/space_xs"
            android:layout_weight="1"
            android:text="@string/profile_action_manage_apps"
            app:icon="@drawable/ic_apps" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnProfileRestore"
            style="@style/Widget.ShizukuManager.Button.Unfreeze"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/space_xs"
            android:layout_weight="1"
            android:text="@string/profile_action_restore"
            app:icon="@drawable/ic_refresh" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnProfileApply"
            style="@style/Widget.ShizukuManager.Button.Freeze"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/profile_action_apply"
            app:icon="@drawable/ic_check" />
    </LinearLayout>
</LinearLayout>
