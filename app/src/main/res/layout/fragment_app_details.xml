<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="@dimen/space_md">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxWidth="@dimen/content_max_width"
            android:orientation="vertical">

            <!-- Top Navigation Header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingBottom="@dimen/space_sm">

                <ImageButton
                    android:id="@+id/btnBackDetails"
                    android:layout_width="@dimen/min_touch_target"
                    android:layout_height="@dimen/min_touch_target"
                    android:background="@drawable/bg_glass_pill"
                    android:contentDescription="@string/cd_back"
                    android:padding="12dp"
                    android:src="@drawable/ic_back"
                    app:tint="@color/brand_primary" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="@dimen/space_sm"
                    android:layout_weight="1"
                    android:text="@string/details_title"
                    android:textAppearance="@style/TextAppearance.ShizukuManager.SectionTitle" />

                <ImageButton
                    android:id="@+id/btnRefreshDetails"
                    android:layout_width="@dimen/min_touch_target"
                    android:layout_height="@dimen/min_touch_target"
                    android:background="@drawable/bg_glass_pill"
                    android:contentDescription="@string/action_refresh"
                    android:padding="12dp"
                    android:src="@drawable/ic_refresh"
                    app:tint="@color/brand_primary" />
            </LinearLayout>

            <!-- Hero App Identity Card -->
            <LinearLayout
                style="@style/Widget.ShizukuManager.GlassCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/ivDetailIcon"
                        android:layout_width="@dimen/app_icon_detail"
                        android:layout_height="@dimen/app_icon_detail"
                        android:contentDescription="@string/cd_app_icon" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_md"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvDetailAppName"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textAppearance="@style/TextAppearance.ShizukuManager.SectionTitle" />

                        <TextView
                            android:id="@+id/tvDetailPackageName"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:textAppearance="@style/TextAppearance.ShizukuManager.Mono" />

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_xs"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/tvDetailTypePill"
                                style="@style/Widget.ShizukuManager.StatePill"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginEnd="@dimen/space_xs" />

                            <TextView
                                android:id="@+id/tvDetailStatePill"
                                style="@style/Widget.ShizukuManager.StatePill"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    android:id="@+id/tvProtectedNotice"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_sm"
                    android:background="@drawable/pill_warning"
                    android:padding="@dimen/space_sm"
                    android:text="@string/details_protected_notice"
                    android:textAppearance="@style/TextAppearance.ShizukuManager.Caption"
                    android:textColor="@color/state_warning_fg"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- Disable vs Suspend Mechanism Note -->
            <LinearLayout
                style="@style/Widget.ShizukuManager.GlassCardSubtle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_sm"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_info"
                    app:tint="@color/brand_primary" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_xs"
                    android:layout_weight="1"
                    android:text="@string/details_mechanism_note"
                    android:textAppearance="@style/TextAppearance.ShizukuManager.Caption" />
            </LinearLayout>

            <!-- Action Controls Glass Card -->
            <LinearLayout
                style="@style/Widget.ShizukuManager.GlassCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_sm"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/details_actions_section"
                        android:textAppearance="@style/TextAppearance.ShizukuManager.SectionTitle" />

                    <ProgressBar
                        android:id="@+id/progressDetailAction"
                        style="?android:attr/progressBarStyleSmall"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:visibility="gone" />
                </LinearLayout>

                <!-- Row 1: Enable / Disable -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_sm"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnDetailEnable"
                        style="@style/Widget.ShizukuManager.Button.Enable"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="@dimen/space_xs"
                        android:layout_weight="1"
                        android:text="@string/op_enable"
                        app:icon="@drawable/ic_enable" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnDetailDisable"
                        style="@style/Widget.ShizukuManager.Button.Disable"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_xs"
                        android:layout_weight="1"
                        android:text="@string/op_disable"
                        app:icon="@drawable/ic_disabled" />
                </LinearLayout>

                <!-- Row 2: Freeze / Unfreeze -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_xs"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnDetailFreeze"
                        style="@style/Widget.ShizukuManager.Button.Freeze"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="@dimen/space_xs"
                        android:layout_weight="1"
                        android:text="@string/op_freeze"
                        app:icon="@drawable/ic_frozen" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnDetailUnfreeze"
                        style="@style/Widget.ShizukuManager.Button.Unfreeze"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_xs"
                        android:layout_weight="1"
                        android:text="@string/op_unfreeze"
                        app:icon="@drawable/ic_check" />
                </LinearLayout>

                <!-- Row 3: Force Stop / Uninstall -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_xs"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnDetailForceStop"
                        style="@style/Widget.ShizukuManager.Button.ForceStop"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="@dimen/space_xs"
                        android:layout_weight="1"
                        android:text="@string/op_force_stop"
                        app:icon="@drawable/ic_force_stop" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnDetailUninstall"
                        style="@style/Widget.ShizukuManager.Button.Uninstall"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_xs"
                        android:layout_weight="1"
                        android:text="@string/op_uninstall"
                        app:icon="@drawable/ic_delete" />
                </LinearLayout>

                <!-- Row 4: Open System App Info -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnDetailOpenInfo"
                    style="@style/Widget.ShizukuManager.Button.Secondary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_xs"
                    android:text="@string/op_open_info"
                    app:icon="@drawable/ic_info" />
            </LinearLayout>

            <!-- Package Metadata Glass Card -->
            <LinearLayout
                style="@style/Widget.ShizukuManager.GlassCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_sm"
                android:layout_marginBottom="@dimen/space_lg"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/space_xs"
                    android:text="@string/details_metadata_section"
                    android:textAppearance="@style/TextAppearance.ShizukuManager.SectionTitle" />

                <LinearLayout
                    android:id="@+id/containerMetadataRows"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
