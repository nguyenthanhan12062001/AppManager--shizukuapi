<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingVertical="8dp">

    <com.google.android.material.checkbox.MaterialCheckBox
        android:id="@+id/cbProfileAppInclude"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minWidth="@dimen/min_touch_target"
        android:minHeight="@dimen/min_touch_target" />

    <ImageView
        android:id="@+id/ivProfilePickerIcon"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:contentDescription="@string/cd_app_icon" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_xs"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvProfilePickerName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textAppearance="@style/TextAppearance.ShizukuManager.CardTitle" />

        <TextView
            android:id="@+id/tvProfilePickerPkg"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textAppearance="@style/TextAppearance.ShizukuManager.Mono" />
    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnProfileTargetAction"
        style="@style/Widget.ShizukuManager.Button.Secondary"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_xs"
        android:minWidth="92dp"
        android:textSize="11.5sp" />
</LinearLayout>
