<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- Top Header & Search -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/space_md"
        android:paddingTop="@dimen/space_md"
        android:paddingEnd="@dimen/space_md"
        android:paddingBottom="@dimen/space_xs">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvListTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/all_apps_title"
                    android:textAppearance="@style/TextAppearance.ShizukuManager.Display" />

                <TextView
                    android:id="@+id/tvListSubtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textAppearance="@style/TextAppearance.ShizukuManager.Body"
                    android:visibility="gone" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/btnSortApps"
                android:layout_width="@dimen/min_touch_target"
                android:layout_height="@dimen/min_touch_target"
                android:layout_marginEnd="@dimen/space_xxs"
                android:background="@drawable/bg_glass_pill"
                android:contentDescription="@string/sort_name_asc"
                android:padding="12dp"
                android:src="@drawable/ic_sort"
                app:tint="@color/brand_primary" />

            <ImageButton
                android:id="@+id/btnRefreshApps"
                android:layout_width="@dimen/min_touch_target"
                android:layout_height="@dimen/min_touch_target"
                android:background="@drawable/bg_glass_pill"
                android:contentDescription="@string/action_refresh"
                android:padding="12dp"
                android:src="@drawable/ic_refresh"
                app:tint="@color/brand_primary" />
        </LinearLayout>

        <!-- Search Pill -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="@dimen/space_sm"
            android:background="@drawable/bg_glass_pill"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="@dimen/space_md"
            android:paddingEnd="@dimen/space_xs">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_search"
                app:tint="@color/text_tertiary" />

            <EditText
                android:id="@+id/etSearchApps"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="@dimen/space_xs"
                android:layout_weight="1"
                android:background="@null"
                android:hint="@string/search_apps_hint"
                android:imeOptions="actionSearch"
                android:inputType="text"
                android:maxLines="1"
                android:textAppearance="@style/TextAppearance.ShizukuManager.Body"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_tertiary" />

            <ImageButton
                android:id="@+id/btnClearSearch"
                android:layout_width="@dimen/min_touch_target"
                android:layout_height="@dimen/min_touch_target"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/action_clear_selection"
                android:src="@drawable/ic_close"
                android:visibility="gone"
                app:tint="@color/text_tertiary" />
        </LinearLayout>

        <!-- Filter Chips (All Apps mode) -->
        <HorizontalScrollView
            android:id="@+id/scrollFilters"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xs"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/chipGroupType"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:selectionRequired="true"
                    app:singleLine="true"
                    app:singleSelection="true">

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipTypeAll"
                        style="@style/Widget.ShizukuManager.FilterChip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/filter_all" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipTypeUser"
                        style="@style/Widget.ShizukuManager.FilterChip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/filter_user" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipTypeSystem"
                        style="@style/Widget.ShizukuManager.FilterChip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/filter_system" />
                </com.google.android.material.chip.ChipGroup>

                <View
                    android:layout_width="1dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center_vertical"
                    android:layout_marginHorizontal="@dimen/space_xs"
                    android:background="@color/glass_stroke_subtle" />

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/chipGroupState"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:selectionRequired="true"
                    app:singleLine="true"
                    app:singleSelection="true">

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipStateAll"
                        style="@style/Widget.ShizukuManager.FilterChip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/filter_all" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipStateEnabled"
                        style="@style/Widget.ShizukuManager.FilterChip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/filter_enabled" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipStateDisabled"
                        style="@style/Widget.ShizukuManager.FilterChip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/filter_disabled" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipStateSuspended"
                        style="@style/Widget.ShizukuManager.FilterChip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/filter_suspended" />
                </com.google.android.material.chip.ChipGroup>
            </LinearLayout>
        </HorizontalScrollView>

        <!-- Multi-Select Bulk Action Panel -->
        <LinearLayout
            android:id="@+id/panelBulkActions"
            style="@style/Widget.ShizukuManager.GlassCardSubtle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xs"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvSelectedCount"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textAppearance="@style/TextAppearance.ShizukuManager.SectionTitle" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSelectAll"
                    style="@style/Widget.ShizukuManager.Button.Secondary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/space_xs"
                    android:text="@string/action_select_all" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnClearSelection"
                    style="@style/Widget.ShizukuManager.Button.Secondary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/action_clear_selection" />
            </LinearLayout>

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xs"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnBulkEnable"
                        style="@style/Widget.ShizukuManager.Button.Enable"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="@dimen/space_xs"
                        android:text="@string/op_enable"
                        app:icon="@drawable/ic_enable" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnBulkDisable"
                        style="@style/Widget.ShizukuManager.Button.Disable"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="@dimen/space_xs"
                        android:text="@string/op_disable"
                        app:icon="@drawable/ic_disabled" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnBulkFreeze"
                        style="@style/Widget.ShizukuManager.Button.Freeze"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="@dimen/space_xs"
                        android:text="@string/op_freeze"
                        app:icon="@drawable/ic_frozen" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnBulkUnfreeze"
                        style="@style/Widget.ShizukuManager.Button.Unfreeze"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="@dimen/space_xs"
                        android:text="@string/op_unfreeze"
                        app:icon="@drawable/ic_check" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnBulkForceStop"
                        style="@style/Widget.ShizukuManager.Button.ForceStop"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/op_force_stop"
                        app:icon="@drawable/ic_force_stop" />
                </LinearLayout>
            </HorizontalScrollView>
        </LinearLayout>
    </LinearLayout>

    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipeRefreshApps"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvApps"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingHorizontal="@dimen/space_md"
                android:paddingTop="@dimen/space_xxs"
                android:paddingBottom="@dimen/space_xl" />

            <!-- Empty State Card -->
            <LinearLayout
                android:id="@+id/emptyAppsContainer"
                style="@style/Widget.ShizukuManager.GlassCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_margin="@dimen/space_lg"
                android:gravity="center"
                android:orientation="vertical"
                android:visibility="gone">

                <com.google.android.material.imageview.ShapeableImageView
                    android:layout_width="200dp"
                    android:layout_height="150dp"
                    android:contentDescription="@string/cd_empty_illustration"
                    android:scaleType="centerCrop"
                    android:src="@drawable/img_empty_apps"
                    app:shapeAppearanceOverlay="@style/ShapeAppearance.ShizukuManager.Card" />

                <TextView
                    android:id="@+id/tvEmptyAppsMessage"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_md"
                    android:gravity="center"
                    android:text="@string/empty_all_apps"
                    android:textAppearance="@style/TextAppearance.ShizukuManager.Body" />
            </LinearLayout>
        </FrameLayout>
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
</LinearLayout>
