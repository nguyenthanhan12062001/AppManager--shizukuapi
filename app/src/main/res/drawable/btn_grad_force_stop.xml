<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <solid android:color="#66908AA8" />
            <corners android:radius="@dimen/radius_button" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <gradient android:angle="0" android:endColor="@color/btn_force_stop_end_pressed" android:startColor="@color/btn_force_stop_start_pressed" />
            <corners android:radius="@dimen/radius_button" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="0" android:endColor="@color/btn_force_stop_end" android:startColor="@color/btn_force_stop_start" />
            <corners android:radius="@dimen/radius_button" />
        </shape>
    </item>
</selector>
